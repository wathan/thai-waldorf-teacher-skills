            </rdf:Alt>
         </dc:rights>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Steiner Waldorf Pedagogy in Schools; A Critical Introduction</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Birthdays</rdf:li>
               <rdf:li>Rudolf Steiner</rdf:li>
               <rdf:li>Generative principles</rdf:li>
               <rdf:li>Self-assessment</rdf:li>
               <rdf:li>Waldorf schools</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
